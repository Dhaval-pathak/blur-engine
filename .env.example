# Gemini API Configuration
GEMINI_API_KEY=your_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Video Generation Settings
DEFAULT_CATEGORY=monuments
DEFAULT_DURATION=5
DEFAULT_CLUES=3

# TTS Voice Configuration
VOICE_NARRATOR=en-IN-NeerjaNeural
VOICE_REVEAL=en-IN-PrabhatNeural

# Output Configuration
OUTPUT_DIR=./output
AUDIO_DIR=./public
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# Blur Engine Settings
BLUR_START_RESOLUTION=10
BLUR_PROGRESSION=exponential

# Performance Settings
GPU_ACCELERATION=true
MAX_BATCH_SIZE=20
